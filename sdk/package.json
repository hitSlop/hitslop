{
  "name": "slop-sdk",
  "private": true,
  "type": "module",
  "bin": {
    "slop-web": "./bin/slop.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/runtime",
    "packages/svelte"
  ],
  "scripts": {
    "postinstall": "node builder/link-template-workspace.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:invoice": "node bin/slop.mjs dev ../Templates/invoice",
    "package:templates": "node bin/slop.mjs package-templates",
    "check:templates": "node bin/slop.mjs package-templates --check"
  },
  "dependencies": {
    "@lucide/svelte": "^1.35.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.0",
    "svelte": "^5.56.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
