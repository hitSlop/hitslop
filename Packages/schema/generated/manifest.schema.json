        {
          "$ref": "#/definitions/SlopWindowShapeCircle"
        },
        {
          "$ref": "#/definitions/SlopWindowShapeImageMask"
        },
        {
          "$ref": "#/definitions/SlopWindowShapeRoundedRect"
        }
      ],
      "title": "SlopWindowShape"
