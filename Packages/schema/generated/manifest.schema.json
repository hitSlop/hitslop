      "required": [
        "width",
        "height",
        "shape"
      ],
      "additionalProperties": false,
      "title": "SlopWindow"
    },
    "__schema11": {
      "type": "integer",
      "minimum": 240,
      "maximum": 4096
    },
    "__schema12": {
      "type": "integer",
      "minimum": 180,
      "maximum": 4096
    },
    "__schema13": {
      "type": "boolean"
    },
    "SlopWindowShape": {
      "oneOf": [
        {
          "$ref": "#/definitions/SlopWindowShapeCapsule"
