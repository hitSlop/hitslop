    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "SlopAuthor": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/__schema4"
        },
        "url": {
          "$ref": "#/definitions/__schema5"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "title": "SlopAuthor"
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "__schema5": {
      "type": "string",
