    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "SlopTags": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema7"
        }
      ]
    },
    "__schema7": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema8"
      },
      "uniqueItems": true
    },
    "__schema8": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "__schema9": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/definitions/SlopStore"
      }
    },
    "SlopStore": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/__schema10"
        },
        "kind": {
          "$ref": "#/definitions/SlopStoreKind"
        },
        "path": {
          "$ref": "#/definitions/__schema11"
        },
        "maxBytes": {
          "$ref": "#/definitions/__schema12"
        }
      },
      "required": [
        "id",
        "kind",
        "path"
      ],
      "additionalProperties": false,
      "title": "SlopStore"
    },
    "__schema10": {
      "type": "string",
