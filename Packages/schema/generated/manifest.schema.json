        "sqlite"
      ],
      "title": "SlopStoreKind"
    },
    "__schema11": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
    },
    "__schema12": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 1073741824
    },
    "SlopWindow": {
      "type": "object",
      "properties": {
        "width": {
          "$ref": "#/definitions/__schema13"
        },
        "height": {
          "$ref": "#/definitions/__schema14"
        },
        "resizable": {
          "$ref": "#/definitions/__schema15"
        },
        "shape": {
          "$ref": "#/definitions/__schema16"
        }
