    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "SlopTags": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema7"
        }
      ]
    },
    "__schema7": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema8"
      },
      "uniqueItems": true
    },
    "__schema8": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "SlopStores": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/__schema9"
      },
      "additionalProperties": {
        "$ref": "#/definitions/SlopStore"
      },
      "title": "SlopStores"
    },
    "__schema9": {
      "type": "string",
