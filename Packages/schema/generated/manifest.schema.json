        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "title": "SlopStore"
    },
    "SlopStoreKind": {
      "type": "string",
      "enum": [
        "json",
        "sqlite"
      ],
      "title": "SlopStoreKind"
    },
    "__schema10": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 1073741824
    },
    "SlopWindow": {
      "type": "object",
      "properties": {
        "width": {
          "$ref": "#/definitions/__schema11"
        },
        "height": {
          "$ref": "#/definitions/__schema12"
        },
        "resizable": {
          "$ref": "#/definitions/__schema13"
