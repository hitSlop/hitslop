    "SlopWindowShapeImageMask": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/__schema16"
        },
        "path": {
          "$ref": "#/definitions/__schema17"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "additionalProperties": false,
      "title": "SlopWindowShapeImageMask"
    },
    "__schema16": {
      "type": "string",
      "const": "imageMask"
    },
    "__schema17": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
    },
    "SlopWindowShapeRoundedRect": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/__schema18"
        },
        "radius": {
          "$ref": "#/definitions/__schema19"
        }
      },
      "required": [
        "kind",
        "radius"
      ],
      "additionalProperties": false,
      "title": "SlopWindowShapeRoundedRect"
    },
    "__schema18": {
      "type": "string",
      "const": "roundedRect"
    },
    "__schema19": {
      "type": "number",
      "minimum": 0,
      "maximum": 256
    },
    "__schema20": {
      "allOf": [
        {
          "$ref": "#/definitions/SlopDocument"
        }
      ]
    },
    "SlopDocument": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/__schema21"
        },
        "template": {
          "$ref": "#/definitions/__schema22"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "title": "SlopDocument"
    },
    "__schema21": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema22": {
      "allOf": [
        {
          "$ref": "#/definitions/SlopTemplateLineage"
        }
      ]
    },
    "SlopTemplateLineage": {
      "type": "object",
      "properties": {
        "publisherKeyId": {
          "$ref": "#/definitions/__schema23"
        },
        "release": {
          "$ref": "#/definitions/__schema24"
        },
        "artifactSha256": {
          "$ref": "#/definitions/__schema25"
        }
      },
      "required": [
        "publisherKeyId",
        "release",
        "artifactSha256"
      ],
      "additionalProperties": false,
      "title": "SlopTemplateLineage"
    },
    "__schema23": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64
    },
    "__schema24": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema25": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$id": "https://hitslop.app/schemas/manifest.schema.json",
  "title": "SlopManifest",
  "description": "The framework-neutral manifest for hitSlop web documents."
}
