      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "title": "SlopWindow"
    },
    "__schema13": {
      "type": "integer",
      "minimum": 240,
      "maximum": 4096
    },
    "__schema14": {
      "type": "integer",
      "minimum": 180,
      "maximum": 4096
    },
    "__schema15": {
      "type": "boolean"
    },
    "__schema16": {
      "allOf": [
        {
          "$ref": "#/definitions/SlopWindowShape"
        }
      ]
    },
    "SlopWindowShape": {
      "oneOf": [
        {
          "$ref": "#/definitions/SlopWindowShapeCapsule"
