          "$ref": "#/definitions/SlopFormat"
        },
        "runtime": {
          "$ref": "#/definitions/SlopRuntime"
        },
        "slug": {
          "$ref": "#/definitions/__schema1"
        },
        "title": {
          "$ref": "#/definitions/__schema2"
        },
        "description": {
          "$ref": "#/definitions/__schema3"
        },
        "author": {
          "$ref": "#/definitions/SlopAuthor"
        },
        "categories": {
          "$ref": "#/definitions/SlopCategories"
        },
        "tags": {
          "$ref": "#/definitions/SlopTags"
        },
        "stores": {
          "$ref": "#/definitions/__schema9"
        },
        "window": {
