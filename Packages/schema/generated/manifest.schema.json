        },
        "stores": {
          "$ref": "#/definitions/SlopStores"
        },
        "window": {
          "$ref": "#/definitions/SlopWindow"
        },
        "document": {
          "$ref": "#/definitions/__schema20"
        }
      },
      "required": [
        "slug",
        "title",
        "description",
        "author",
        "categories",
        "stores",
        "window"
      ],
      "additionalProperties": false,
      "title": "SlopManifest"
    },
    "__schema0": {
      "type": "string"
    },
    "__schema1": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "SlopAuthor": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/__schema4"
        },
        "url": {
          "$ref": "#/definitions/__schema5"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "title": "SlopAuthor"
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "__schema5": {
      "type": "string",
      "format": "uri"
