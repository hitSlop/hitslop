{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SlopManifest",
  "definitions": {
    "SlopManifest": {
      "type": "object",
      "properties": {
        "$schema": {
          "$ref": "#/definitions/__schema0"
        },
        "slug": {
          "$ref": "#/definitions/__schema1"
        },
        "title": {
          "$ref": "#/definitions/__schema2"
        },
        "description": {
          "$ref": "#/definitions/__schema3"
        },
        "author": {
          "$ref": "#/definitions/SlopAuthor"
