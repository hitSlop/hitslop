      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "title": "SlopWindowShapeCapsule"
    },
    "__schema14": {
      "type": "string",
      "const": "capsule"
    },
    "SlopWindowShapeCircle": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/__schema15"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
