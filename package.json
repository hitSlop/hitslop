{
  "name": "hitslop",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first LLM mini-docs. A .slop file is a SQLite database you can open, query, and share.",
  "type": "module",
  "bin": {
    "slop": "./src/cli.ts"
  },
  "scripts": {
    "slop": "bun src/cli.ts",
    "pack": "bun src/cli.ts pack examples/climbing",
    "open": "bun src/cli.ts open examples/climbing.slop",
    "serve": "bun src/cli.ts serve examples/climbing.slop",
    "test": "bun test",
    "host": "bun src/cli.ts open examples/climbing.slop"
  }
}
