{
  "$schema": "https://hitslop.app/schemas/manifest.schema.json",
  "slug": "random-picker",
  "title": "Random Picker",
  "description": "A playful capsule for choosing one option and remembering recent picks.",
  "author": { "name": "Longtail Labs" },
  "categories": ["Utilities", "Widgets"],
  "tags": ["random", "picker", "json", "capsule", "bits-ui"],
  "stores": {
    "state": { "kind": "json", "maxBytes": 1048576 }
  },
  "window": { "width": 560, "height": 320, "shape": { "kind": "capsule" } }
}
