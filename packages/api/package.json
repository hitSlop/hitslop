{
  "name": "@hitslop/api",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "generated"
  ],
  "exports": {
    ".": "./dist/contract.js",
    "./client": "./dist/client.js"
  },
  "scripts": {
    "build": "bun ../../scripts/clean-dist.ts && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "bun run --cwd ../schema build && bun test tests",
    "generate": "bun src/generate.ts"
  },
  "dependencies": {
    "@hitslop/schema": "0.3.0",
    "@orpc/client": "2.0.0-beta.36",
    "@orpc/contract": "2.0.0-beta.36",
    "@orpc/openapi": "2.0.0-beta.36",
    "@standard-schema/spec": "^1.1.0",
    "typebox": "^1.3.32"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "description": "Typed hitSlop HTTP contracts, client, and generated OpenAPI specification.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hitslop/hitslop.git",
    "directory": "packages/api"
  },
  "publishConfig": {
    "access": "public"
  }
}
