{
  "name": "@hitslop/cli",
  "version": "0.1.0",
  "description": "Create, develop, build, install, and publish hitSlop apps.",
  "type": "module",
  "bin": {
    "slop": "./dist/cli.js"
  },
  "files": ["dist", "templates"],
  "scripts": {
    "build": "bun build src/cli.ts --target bun --format esm --packages external --outfile dist/cli.js && /bin/chmod +x dist/cli.js",
    "check": "tsc -p tsconfig.json",
    "test": "bun run --cwd ../schema build && bun test"
  },
  "dependencies": {
    "@crustjs/core": "^0.0.19",
    "@hitslop/schema": "workspace:*",
    "@noble/ed25519": "^3.2.0",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
