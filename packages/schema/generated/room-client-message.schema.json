{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "type",
        "protocol",
        "documentId",
        "schema",
        "after"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "hello"
          ]
        },
        "protocol": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "documentId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]{1,80}$"
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "title": "RoomHello",
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "sequence"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "applied"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "title": "RoomApplied",
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "protocol",
        "documentId",
        "schema",
        "batch"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "append"
          ]
        },
        "protocol": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "documentId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]{1,80}$"
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "batch": {
          "type": "object",
          "required": [
            "id",
            "hash",
            "bytes"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 699052
            }
          },
          "title": "RoomBatch",
          "additionalProperties": false
        }
      },
      "title": "RoomAppend",
      "additionalProperties": false
    }
  ],
  "title": "RoomClientMessage"
}
