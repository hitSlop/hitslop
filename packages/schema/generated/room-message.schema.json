{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "type",
        "protocol",
        "peers"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        },
        "protocol": {
          "type": "number",
          "const": 3
        },
        "peers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "title": "RoomPeer",
            "additionalProperties": false
          },
          "maxItems": 20
        }
      },
      "title": "RoomWelcome",
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "peers"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "presence"
        },
        "peers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "title": "RoomPeer",
            "additionalProperties": false
          },
          "maxItems": 20
        }
      },
      "title": "RoomPresence",
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "open",
        "peers"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "ready"
        },
        "open": {
          "type": "object",
          "required": [
            "snapshot",
            "lease"
          ],
          "properties": {
            "snapshot": {
              "type": "object",
              "required": [
                "documentId",
                "schemaHash",
                "authority",
                "revision",
                "data"
              ],
              "properties": {
                "documentId": {
                  "type": "string",
                  "minLength": 1
                },
                "schemaHash": {
                  "type": "string",
                  "minLength": 1
                },
                "authority": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "data": {}
              },
              "additionalProperties": false
            },
            "lease": {
              "type": "object",
              "required": [
                "id",
                "expiresAt"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "expiresAt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            },
            "status": {
              "type": "object",
              "required": [
                "connected",
                "writable"
              ],
              "properties": {
                "connected": {
                  "type": "boolean"
                },
                "writable": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "peers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "title": "RoomPeer",
            "additionalProperties": false
          },
          "maxItems": 20
        }
      },
      "title": "RoomReady",
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "snapshot"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "snapshot"
        },
        "snapshot": {
          "type": "object",
          "required": [
            "documentId",
            "schemaHash",
            "authority",
            "revision",
            "data"
          ],
          "properties": {
            "documentId": {
              "type": "string",
              "minLength": 1
            },
            "schemaHash": {
              "type": "string",
              "minLength": 1
            },
            "authority": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "data": {}
          },
          "additionalProperties": false
        }
      },
      "title": "RoomSnapshotMessage",
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "requestId",
        "leaseId",
        "authority",
        "result"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "result"
        },
        "requestId": {
          "type": "string"
        },
        "leaseId": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "ok",
                "revision"
              ],
              "properties": {
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "ok",
                "error"
              ],
              "properties": {
                "ok": {
                  "type": "boolean",
                  "const": false
                },
                "error": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "enum": [
                        "invalid_request",
                        "invalid_path",
                        "invalid_operation",
                        "missing_target",
                        "missing_anchor",
                        "duplicate_id",
                        "identity_change",
                        "validation",
                        "stale_revision",
                        "request_reused",
                        "offline",
                        "rejected",
                        "unknown_outcome",
                        "batch_usage",
                        "closed",
                        "not_ready",
                        "authority_changed",
                        "lease_expired",
                        "storage_unavailable"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "title": "RoomResultMessage",
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "status",
        "message"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "message": {
          "type": "string"
        }
      },
      "title": "RoomError",
      "additionalProperties": false
    }
  ],
  "title": "RoomServerMessage"
}
