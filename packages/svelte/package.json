{
  "name": "@hitslop/svelte",
  "version": "0.1.0",
  "description": "Svelte 5 state adapters for the hitSlop runtime.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/hitslop/hitslop.git", "directory": "packages/svelte" },
  "homepage": "https://hitslop.app",
  "bugs": { "url": "https://github.com/hitslop/hitslop/issues" },
  "keywords": ["hitslop", "svelte", "local-first", "mini-apps"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "bun ../../scripts/clean-dist.ts && tsc -p tsconfig.build.json",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "test": "echo 'no unit tests: pure logic lives in @hitslop/runtime; rune adapters are covered by svelte-check and the examples'"
  },
  "dependencies": {
    "@hitslop/runtime": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3"
  }
}
