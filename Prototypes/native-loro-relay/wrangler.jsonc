{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hitslop-native-loro-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "SlopRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SlopRoom"] }],
  "vars": { "TEST_CONTROLS": "true" },
  "observability": { "enabled": false }
}
