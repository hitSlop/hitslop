{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hitslop-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hitslop",
      "database_id": "local-hitslop",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "hitslop"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "SlopRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SlopRoom"] }],
  "vars": {
    "FIREBASE_PROJECT_ID": "hitslopapp"
  }
}
