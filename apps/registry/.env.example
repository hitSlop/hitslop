# Created automatically by `bunx convex dev`; never commit the real value.
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Public and safe to expose in browser clients. Keep the real value in .env.local.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Server-side only. Set production values with `bunx convex env set`.
HITSLOP_INTERNAL_SECRET=
