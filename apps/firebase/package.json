{
  "name": "@hitslop/firebase",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "bun test tests",
    "test:emulator": "firebase emulators:exec --only firestore --project hitslopapp 'bun test tests/backend-emulator.test.ts && bun test tests/rules-emulator.test.ts'",
    "dev": "firebase emulators:start --project hitslopapp",
    "deploy": "npm run build && firebase deploy --project hitslopapp"
  },
  "dependencies": {
    "@hitslop/schema": "0.1.3",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.3.0",
    "firebase": "^12.18.0",
    "firebase-tools": "^15.29.0",
    "typescript": "^7.0.2"
  }
}
