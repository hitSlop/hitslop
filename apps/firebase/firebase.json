{
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": [
      ".firebase",
      "firebase-debug.log",
      "tests",
      "public",
      "*.rules",
      "*.indexes.json"
    ],
    "predeploy": ["npm run build"]
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "cleanUrls": false,
    "headers": [
      {
        "source": "/schemas/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "us-central1",
          "pinTag": true
        }
      }
    ]
  },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5002 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
