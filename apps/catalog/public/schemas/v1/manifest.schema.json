{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SlopManifest",
  "$defs": {
    "SlopManifest": {
      "type": "object",
      "properties": {
        "$schema": {
          "$ref": "#/$defs/__schema0"
        },
        "slug": {
          "$ref": "#/$defs/__schema1"
        },
        "title": {
          "$ref": "#/$defs/__schema2"
        },
        "description": {
          "$ref": "#/$defs/__schema3"
        },
        "categories": {
          "$ref": "#/$defs/SlopCategories"
        },
        "presentation": {
          "$ref": "#/$defs/SlopPresentation"
        }
      },
      "required": [
        "$schema",
        "slug",
        "title",
        "description",
        "categories",
        "presentation"
      ],
      "additionalProperties": false,
      "title": "SlopManifest"
    },
    "__schema0": {
      "type": "string",
      "const": "https://hitslop.app/schemas/v1/manifest.schema.json"
    },
    "__schema1": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "SlopCategories": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/SlopCategory"
      },
      "title": "SlopCategories",
      "uniqueItems": true
    },
    "SlopCategory": {
      "type": "string",
      "enum": [
        "productivity",
        "utilities",
        "finance",
        "media",
        "games",
        "developer-tools",
        "education",
        "business",
        "personal",
        "other"
      ],
      "title": "SlopCategory"
    },
    "SlopPresentation": {
      "anyOf": [
        {
          "$ref": "#/$defs/SlopStandardPresentation"
        },
        {
          "$ref": "#/$defs/SlopSkinPresentation"
        }
      ],
      "title": "SlopPresentation"
    },
    "SlopStandardPresentation": {
      "type": "object",
      "properties": {
        "width": {
          "$ref": "#/$defs/__schema4"
        },
        "height": {
          "$ref": "#/$defs/__schema5"
        },
        "resizable": {
          "$ref": "#/$defs/__schema6"
        },
        "shape": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "title": "SlopStandardPresentation"
    },
    "__schema4": {
      "type": "integer",
      "minimum": 240,
      "maximum": 4096
    },
    "__schema5": {
      "type": "integer",
      "minimum": 180,
      "maximum": 4096
    },
    "__schema6": {
      "type": "boolean"
    },
    "__schema7": {
      "type": "string",
      "enum": [
        "rounded",
        "ellipse",
        "capsule"
      ]
    },
    "SlopSkinPresentation": {
      "type": "object",
      "properties": {
        "width": {
          "$ref": "#/$defs/__schema4"
        },
        "height": {
          "$ref": "#/$defs/__schema5"
        },
        "skin": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": [
        "width",
        "height",
        "skin"
      ],
      "additionalProperties": false,
      "title": "SlopSkinPresentation"
    },
    "__schema8": {
      "type": "string",
      "minLength": 12,
      "maxLength": 240,
      "pattern": "^assets\\/(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._/-]+\\.png$"
    }
  },
  "$id": "https://hitslop.app/schemas/v1/manifest.schema.json",
  "title": "SlopManifest",
  "description": "The framework-neutral manifest for hitSlop web documents."
}
