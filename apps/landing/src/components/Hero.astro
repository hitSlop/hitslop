  z-index: -1;
  inset: 0 calc((100% - 100vw) / 2);
  pointer-events: none;
  background: radial-gradient(ellipse at 73% 14%, #e8e2ff 0, transparent 53%), radial-gradient(ellipse at 28% 67%, #fff0fa 0, transparent 48%), radial-gradient(ellipse at 90% 90%, #e5fbfa 0, transparent 44%);
}

