---
import * as s from "./TerminalWalkthrough.css";

const steps = [
  { note: "From the hitSlop source checkout.", commands: ["bun install --frozen-lockfile", "bun slop init my-slop"] },
  { note: "Preview with disposable memory storage.", commands: ["bun slop dev my-slop"] },
  { note: "Build a template with native previews.", commands: ["bun slop build my-slop"] },
  { note: "Add it to your local template catalog.", commands: ["bun slop register my-slop"] },
];
---

<figure class={s.terminal} aria-label="Create a slop in your terminal">
  <div class={s.bar}>
    <span class={s.lights} aria-hidden="true"><i class={s.red}></i><i class={s.yellow}></i><i class={s.green}></i></span>
    <span class={s.windowTitle}>Terminal</span>
    <span class={s.example}>Example workflow</span>
  </div>
  <div class={s.transcript}>
    {steps.map((step) => (
      <div class={s.step}>
        <p class={s.note}># {step.note}</p>
        {step.commands.map((command) => (
          <div class={s.commandLine}><span class={s.prompt} aria-hidden="true">$</span><code class={s.command}>{command}</code></div>
        ))}
      </div>
    ))}
  </div>
  <figcaption class={s.result}>
    <svg class={s.fileIcon} aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6Z" /><path d="M14 3v6h6M8 14h8M8 17h5" /></svg>
    <div class={s.resultCopy}><code class={s.output}>my-slop.slop</code><span class={s.resultHint}>Your app, ready to open in hitSlop.</span></div>
  </figcaption>
</figure>
