---

const steps = [
  { note: "Create a project anywhere with Bun.", commands: ["bunx @hitslop/cli init my-slop", "cd my-slop", "bun install"] },
  { note: "Preview with disposable memory storage.", commands: ["bun run dev"] },
  { note: "Build a template with native previews.", commands: ["bun run build"] },
  { note: "Add it to your local template catalog.", commands: ["bun run register"] },
];
---

<figure class="terminal-terminal" aria-label="Create a slop in your terminal">
  <div class="terminal-bar">
    <span class="terminal-lights" aria-hidden="true"><i class="terminal-red terminal-light"></i><i class="terminal-yellow terminal-light"></i><i class="terminal-green terminal-light"></i></span>
    <span class="terminal-window-title">Terminal</span>
    <span class="terminal-example">Example workflow</span>
  </div>
  <div class="terminal-transcript">
    {steps.map((step) => (
      <div class="terminal-step">
        <p class="terminal-note"># {step.note}</p>
        {step.commands.map((command) => (
          <div class="terminal-command-line"><span class="terminal-prompt" aria-hidden="true">$</span><code class="terminal-command">{command}</code></div>
        ))}
      </div>
    ))}
  </div>
  <figcaption class="terminal-result">
    <svg class="terminal-file-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6Z" /><path d="M14 3v6h6M8 14h8M8 17h5" /></svg>
    <div class="terminal-result-copy"><code class="terminal-output">my-slop.slop</code><span class="terminal-result-hint">Your app, ready to open in hitSlop.</span></div>
  </figcaption>
</figure>

<style>
.terminal-terminal {
  width: 100%;
  min-width: 0;
  margin: 0;
  overflow: hidden;
  border-radius: 16px;
  color: oklch(94% .012 255);
  background: oklch(21% .025 255);
  box-shadow: 0 24px 56px oklch(18% .04 260 / .18);
}

.terminal-bar {
  min-height: 52px;
  padding: 12px 20px;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px 16px;
  background: oklch(26% .025 255);
}

.terminal-lights {
  display: flex;
  gap: 6px;
}

.terminal-light {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.terminal-red {
  background: oklch(71% .17 32);
}

.terminal-yellow {
  background: oklch(85% .16 91);
}

.terminal-green {
  background: oklch(72% .13 145);
}

.terminal-window-title {
  font-size: 13px;
  font-weight: 650;
}

.terminal-example {
  margin-left: auto;
  font-size: 12px;
  color: oklch(77% .02 255);
}

.terminal-transcript {
  padding: clamp(20px, 3vw, 32px);
  display: grid;
  gap: 24px;
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  font-size: 14px;
  line-height: 1.65;
}

.terminal-step {
  min-width: 0;
  display: grid;
  gap: 4px;
}

.terminal-note {
  margin: 0 0 4px;
  color: oklch(76% .025 255);
  font-size: 12px;
  overflow-wrap: anywhere;
}

.terminal-command-line {
  display: grid;
  grid-template-columns: 12px minmax(0, 1fr);
  gap: 10px;
}

.terminal-prompt {
  color: oklch(81% .13 155);
  user-select: none;
}

.terminal-command {
  font-family: inherit;
  font-size: inherit;
  overflow-wrap: anywhere;
}

.terminal-result {
  padding: 20px clamp(20px, 3vw, 32px);
  display: flex;
  align-items: center;
  gap: 14px;
  background: oklch(27% .04 155);
}

.terminal-file-icon {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  stroke: oklch(81% .13 155);
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.terminal-result-copy {
  min-width: 0;
  display: grid;
  gap: 4px;
}

.terminal-output {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  font-size: 14px;
  overflow-wrap: anywhere;
}

.terminal-result-hint {
  font-size: 12px;
  color: oklch(81% .025 155);
}

</style>
